                </statOffsets>
                <multiplyStatChangesBySeverity>true</multiplyStatChangesBySeverity>
            </li>
        </stages>
    </HediffDef>

    <HediffDef MayRequire="EBSG.Framework">
        <defName>EternalLethalEvolution</defName>
        <label>hidden lethal evolution</label>
        <description>Every time this pawn kills an enemy they become more lethal</description>
        <hediffClass>HediffWithComps</hediffClass>
		<scenarioCanAdd>False</scenarioCanAdd>
		<isBad>False</isBad>
        <everCurableByItem>False</everCurableByItem>
        <stages>
            <li>
                <becomeVisible>false</becomeVisible>
            </li>
        </stages>
        <comps>
            <li Class="EBSGFramework.HediffCompProperties_HediffOnKill">
