    <HediffDef ParentName="Eternal-H-Base">
        <defName>Eternal-H-Core</defName>
        <label>eternal-core</label>
        <description>This hediff provides enhanced physical capabilities</description>
        <stages>
            <li>
                <painFactor>0.85</painFactor>
                <damageFactors>
                    <Flame>0.85</Flame>
                </damageFactors>

                <statFactors>
                    <AimingDelayFactor>0.85</AimingDelayFactor>
                    <MeleeCooldownFactor>0.85</MeleeCooldownFactor>
                    <StaggerDurationFactor>0.85</StaggerDurationFactor>
                    <PawnTrapSpringChance>0.85</PawnTrapSpringChance>
                    <MentalBreakThreshold>0.85</MentalBreakThreshold>
                    <CancerRate>0.85</CancerRate>
                    <IncomingDamageFactor>0.85</IncomingDamageFactor>
                    <Flammability>0.85</Flammability>
                    <MoveSpeed>1.1</MoveSpeed>
                    <InjuryHealingFactor>1.15</InjuryHealingFactor>
                    <ImmunityGainSpeed>1.15</ImmunityGainSpeed>
                    <RawNutritionFactor>1.15</RawNutritionFactor>
                    <ToxicResistance>1.15</ToxicResistance>
                    <ToxicEnvironmentResistance>1.15</ToxicEnvironmentResistance>
                    <PainShockThreshold>1.15</PainShockThreshold>
                    <CarryingCapacity>1.15</CarryingCapacity>
                    <VEF_MassCarryCapacity MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">1.5</VEF_MassCarryCapacity>
                    <GlobalLearningFactor>1.15</GlobalLearningFactor>
                    <LearningRateFactor>1.15</LearningRateFactor>
                    <ResearchSpeed>1.15</ResearchSpeed>
                    <WorkSpeedGlobal>1.15</WorkSpeedGlobal>
                    <HackingSpeed MayRequire="ludeon.rimworld.ideology">1.15</HackingSpeed>
                    <ShootingAccuracyPawn>1.15</ShootingAccuracyPawn>    
                    <SocialImpact>1.15</SocialImpact>
                    <TameAnimalChance>1.15</TameAnimalChance>
                    <TrainAnimalChance>1.15</TrainAnimalChance>
                    <NegotiationAbility>1.15</NegotiationAbility>
                    <ConversionPower MayRequire="ludeon.rimworld.ideology">1.25</ConversionPower>
                    <MeleeDodgeChance>1.15</MeleeDodgeChance>
                    <MeleeHitChance>1.15</MeleeHitChance>
                    <MeleeDamageFactor>1.25</MeleeDamageFactor>
                    <LifespanFactor>1.5</LifespanFactor>
                    <Fertility>2</Fertility>
                    <PawnBeauty>2</PawnBeauty>
                </statFactors>
                <statFactorEffectMultiplier>EternalComposition</statFactorEffectMultiplier>

                <capMods>
                    <li>
                        <capacity>BloodFiltration</capacity>
                        <postFactor>1.15</postFactor>
                    </li>
                    <li>
                        <capacity>BloodPumping</capacity>
                        <postFactor>1.15</postFactor>
                    </li>
                    <li>
                        <capacity>Hearing</capacity>
                        <postFactor>1.15</postFactor>
                    </li>
                    <li>
                        <capacity>Sight</capacity>
                        <postFactor>1.15</postFactor>
                    </li>
                    <li>
                        <capacity>Breathing</capacity>
                        <postFactor>1.15</postFactor>
                    </li>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>1.15</postFactor>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <postFactor>1.15</postFactor>
                    </li>
                </capMods>
                <capacityFactorEffectMultiplier>EternalComposition</capacityFactorEffectMultiplier>

                <statOffsets>
